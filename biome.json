{
  "$schema": "https://biomejs.dev/schemas/2.6.5/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["src/**", "test/**", "scripts/**", "migrations/**", "*.json", "*.cjs"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 110 },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useImportType": "off" },
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "javascript": { "parser": { "unsafeParameterDecoratorsEnabled": true } }
}
