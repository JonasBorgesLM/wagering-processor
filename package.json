{
  "name": "wagering-processor",
  "version": "1.1.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.4",
  "scripts": {
    "start": "bun run src/main.ts",
    "migrate": "bun run scripts/migrate.ts",
    "provision": "bun run scripts/provision-queues.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && ./.github/scripts/check-boundaries.sh && ./.github/scripts/check-money.sh",
    "format": "biome format --write .",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "test:load": "bun run test/load/load.ts",
    "test:mutation": "bun run test/mutation/run.ts",
    "check:docs": "./.github/scripts/check-docs.sh"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "3.1164.0",
    "@mikro-orm/core": "7.2.8",
    "@mikro-orm/migrations": "7.2.8",
    "@mikro-orm/postgresql": "7.2.8",
    "@nestjs/common": "12.4.0",
    "@nestjs/core": "12.4.0",
    "@nestjs/platform-express": "12.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/bun": "1.4.4",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dependency-cruiser": "18.7.2",
    "lefthook": "2.2.2",
    "typescript": "6.0.3"
  }
}
