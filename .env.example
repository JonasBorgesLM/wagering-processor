# Copied to .env for local runs. Values match docker-compose.yml.
PORT=3000
APP_ROLES=api,consumer,publisher,reference-worker
DATABASE_URL=postgres://wagering:wagering@localhost:5433/wagering
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SHUTDOWN_TIMEOUT_MS=25000
LOCK_TIMEOUT_MS=2000
STATEMENT_TIMEOUT_MS=5000
DATABASE_POOL_MAX=10
RECONCILIATION_MAX_CONCURRENT=2
DATABASE_ACQUIRE_TIMEOUT_MS=1000
QUEUE_WAIT_SECONDS=5
QUEUE_BACKOFF_BASE_SECONDS=2
QUEUE_BACKOFF_CAP_SECONDS=30
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_BATCH_SIZE=100
OUTBOX_PUBLISH_CONCURRENCY=1
OUTBOX_LEASE_MS=30000
OUTBOX_RETRY_BASE_SECONDS=1
OUTBOX_RETRY_CAP_SECONDS=60
REFERENCE_TTL_SECONDS=3600
REFERENCE_RETRY_BASE_SECONDS=5
REFERENCE_RETRY_CAP_SECONDS=300
REFERENCE_BATCH_SIZE=25
REFERENCE_LEASE_MS=30000
REFERENCE_POLL_INTERVAL_MS=1000
